# QA server environment (sourced by harness/start_sso.sh and harness/manage.sh). Throw-away SQLite DB and keys
# under qa/run/ (gitignored). Key config @ 610c9b8/d784f10: file NAMES resolved in SSO_JWT_KEYS_MOUNT.
QA_RUN="${QA_RUN:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../run" && pwd)}"
export SSO_ENV_FILE=''
export SSO_SECRET_KEY="${SSO_SECRET_KEY:-$(cat "$QA_RUN/secret_key" 2>/dev/null || true)}"
export SSO_DEBUG='False'
export SSO_ALLOWED_HOSTS='127.0.0.1,localhost'
export SSO_AUDIENCE='myfin-services'
export SSO_DB_ENGINE='sqlite'
export SSO_SQLITE_PATH="${SSO_SQLITE_PATH:-$QA_RUN/sso-qa.sqlite3}"
# new key variables (the deprecated *_PATH forms must stay unset: old + new together = ImproperlyConfigured)
unset SSO_KEYS_DIR SSO_JWT_PRIVATE_KEY_PATH SSO_JWT_PUBLIC_KEY_PATHS SSO_JWT_PUBLIC_KEY_PATH
export SSO_JWT_KEYS_MOUNT="${SSO_JWT_KEYS_MOUNT:-$QA_RUN/keys}"
export SSO_JWT_PRIVATE_KEY="${SSO_JWT_PRIVATE_KEY:-qa-test.private.pem}"
export SSO_JWT_PUBLIC_KEYS="${SSO_JWT_PUBLIC_KEYS:-qa-test.public.pem}"
export SSO_CORS_ALLOWED_ORIGINS='https://example.com'
export SSO_SSL_REDIRECT='False'
export SSO_HSTS_SECONDS='0'
export SSO_NUM_PROXIES='0'
export SSO_COOKIE_DOMAIN=''
export PYTHONDONTWRITEBYTECODE='1'
export SSO_CACHE_URL="${SSO_CACHE_URL:-filecache:///tmp/qa-cache-$$}"
export SSO_VENV="${SSO_VENV:-qa/.venv-py3.13.16}"
