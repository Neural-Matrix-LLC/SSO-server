# LOCAL DEV values for docker-compose.dev.yml (scripts/dev_setup.sh copies this to .env).
# Placeholders only: no real secrets, no real hosts. Change SSO_HTTPS_PORT if 8443 is taken
# (then update SSO_ISSUER, SSO_CORS_ALLOWED_ORIGINS and SSO_CSRF_TRUSTED_ORIGINS to match).
SSO_SECRET_KEY=__generated_by_dev_setup__
SSO_DEBUG=False
SSO_ALLOWED_HOSTS=localhost,web
SSO_ISSUER=https://localhost:8443
SSO_AUDIENCE=myfin-services
SSO_ADMIN_PATH=sso-admin/
SSO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
SSO_JWT_PRIVATE_KEY_PATH=/run/keys/dev.private.pem
SSO_JWT_PUBLIC_KEY_PATHS=/run/keys/dev.public.pem
SSO_CORS_ALLOWED_ORIGINS=https://localhost:8443
SSO_COOKIE_DOMAIN=
SSO_CACHE_URL=redis://redis:6379/0
SSO_NUM_PROXIES=1
# lets the verifier container fetch JWKS from http://web:8000 inside the compose network (dev only)
SSO_SSL_REDIRECT=False
SSO_HSTS_SECONDS=0

SSO_IMAGE_TAG=dev
SSO_DOMAIN=localhost
SSO_HOSTNAME=localhost
SSO_HTTP_PORT=8080
SSO_HTTPS_PORT=8443
SSO_KEYS_DIR=./keys
SSO_CERTS_DIR=./docker/certs
SSO_TLS_CERT_FILE=selfsigned.crt
SSO_TLS_KEY_FILE=selfsigned.key
# DB passwords for the local MySQL (dev_setup.sh appends SSO_TEST_* from .env.test below)
