# SSO server configuration (spec §9.4 + addendum v1.1 + deployment plan R10).
# Copy to .env (chmod 600), fill in, never commit.
# Host names and ports are still undecided (deployment plan §0): every example.com value below is a
# placeholder derived from SSO_DOMAIN / SSO_HOSTNAME / SSO_HTTPS_PORT. The app does not compute them;
# write them out. If SSO_HTTPS_PORT is not 443, the port goes into SSO_ISSUER and every origin.

# ---- core (required when SSO_DEBUG=False; the server refuses to start otherwise)
SSO_SECRET_KEY=
SSO_DEBUG=False
SSO_ALLOWED_HOSTS=sso.example.com
# Public base URL of this server = JWT "iss" (scheme + host [+ :port], no trailing slash)
SSO_ISSUER=https://sso.example.com
SSO_AUDIENCE=myfin-services
# Admin URL prefix (spec §9.6: non-default path)
SSO_ADMIN_PATH=sso-admin/
# Extra origins allowed to POST to the admin through the proxy (usually just the public URL)
SSO_CSRF_TRUSTED_ORIGINS=https://sso.example.com

# ---- database: remote MySQL 8.4 dcWebUsers (runtime account sso_app: DML only)
SSO_DB_ENGINE=mysql
SSO_DBHOST=
SSO_DBPORT=3306
SSO_DBNAME=dcWebUsers
SSO_DBUSER=sso_app
SSO_DBPWD=
# optional DB TLS verification (deployment plan §6.0 / R28); CA mounted from SSO_MYSQL_CA_DIR
# SSO_DB_SSL_CA=/run/mysql-ca/ca.pem
# SSO_DB_SSL_MODE=VERIFY_CA          # DISABLED | PREFERRED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY

# ---- JWT keys (mounted read-only at /run/keys; generate with scripts/gen_keys.sh)
SSO_JWT_PRIVATE_KEY_PATH=/run/keys/sso-2026-10.private.pem
# comma-separated: EVERY public key to publish in JWKS and accept (key rotation)
SSO_JWT_PUBLIC_KEY_PATHS=/run/keys/sso-2026-10.public.pem
SSO_ACCESS_TTL_MIN=15
SSO_REFRESH_TTL_DAYS=7

# ---- browser clients
SSO_CORS_ALLOWED_ORIGINS=https://fin.example.com
SSO_COOKIE_DOMAIN=.example.com

# ---- shared cache for throttling. REQUIRED when SSO_DEBUG=False: empty, locmem:// or dummy:// refuse
# to start. docker-compose.yml defaults it to the redis service; outside compose use redis://... or,
# on a single host without Redis, filecache:///var/tmp/sso-cache
SSO_CACHE_URL=redis://redis:6379/0
# reverse proxies in front of gunicorn whose X-Forwarded-For is trusted for the client IP.
# Code default 0 (header ignored). docker-compose.yml defaults it to 1 for its nginx and takes this
# value if set; only raise it if every proxy hop OVERWRITES X-Forwarded-For and is the only way to
# reach gunicorn (see README §7, shared host nginx).
# SSO_NUM_PROXIES=1

# ---- optional tuning (defaults shown)
# SSO_THROTTLE_LOGIN=10/min
# SSO_THROTTLE_LOGIN_USER=5/min
# SSO_THROTTLE_REFRESH=60/min
# SSO_LOG_LEVEL=INFO
# SSO_SSL_REDIRECT=True
# SSO_HSTS_SECONDS=31536000
# SSO_COOKIE_SECURE=True

# ---- deployment parameters (deployment plan §0) and docker compose only (not read by Django)
# SSO_DOMAIN is informational: it is what SSO_COOKIE_DOMAIN / origins above are derived from.
SSO_DOMAIN=example.com
SSO_HOSTNAME=sso.example.com
SSO_HTTPS_PORT=443
SSO_HTTP_PORT=80
# Image = ${DOCKER_USER}/sso-server:${IMAGE_TAG} on Docker Hub. NOTE: for every variable that compose
# interpolates (these, the ports, SSO_UID/SSO_GID ...), an exported shell variable of the same name OVERRIDES
# the value in this file, e.g.  IMAGE_TAG=0.1.1 docker compose up -d  or a leftover "export IMAGE_TAG=...".
# Check what compose will use with:  docker compose config --images
DOCKER_USER=thomaschoi
# pin a real version on servers (compose falls back to "latest" if this is empty/unset)
IMAGE_TAG=0.1.0
# uid/gid of the non-root container user (build arg + compose "user:"; default 10001). Set them to the
# owner of the host key files (SSO_KEYS_DIR) so the private key can stay mode 0600. Never 0.
SSO_UID=10001
SSO_GID=10001
GUNICORN_WORKERS=3
SSO_KEYS_DIR=./keys
SSO_CERTS_DIR=./docker/certs
SSO_TLS_CERT_FILE=fullchain.pem
SSO_TLS_KEY_FILE=privkey.pem
# SSO_ACME_WEBROOT=./docker/acme
# SSO_MYSQL_CA_DIR=./mysql-ca
# SSO_ADMIN_ALLOW_DIR=./docker/nginx-admin.d
# subnet of the compose "edge" network (nginx <-> web) and what gunicorn trusts X-Forwarded-Proto from
# SSO_EDGE_SUBNET=172.31.250.0/24
# SSO_FORWARDED_ALLOW_IPS=172.31.250.0/24

# ---- phase 5 account e-mails (unused in sprint 1)
E_HOST=
E_PORT=
EMAIL_USER=
EMAIL_PWD=
