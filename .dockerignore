# Never send secrets or local state to the build context (deployment plan R3).
.git
.gitignore
.venv*
**/__pycache__
**/*.pyc
.pytest_cache
.coverage*
htmlcov
keys
**/*.pem
**/*.key
**/*.crt
.env
.env.*
# the placeholder template ships in the image as /app/deploy/env.example (no values)
!.env.example
*.sql
*.sql.gz
*.sqlite3
docker/certs
letsencrypt
qa
examples
devops
docs
staticfiles
backups
